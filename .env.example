# =============================================================================
# OAX Tech — environment variables
# =============================================================================
# Copy to .env.local and fill in. The site BUILDS AND RUNS with all of these
# empty: every integration reports "not configured" instead of faking success.
#
# Never commit .env.local. Only NEXT_PUBLIC_* values reach the browser.
# =============================================================================

# --- Site --------------------------------------------------------------------
# Canonical origin. Used for canonical tags, Open Graph, sitemap and robots.
NEXT_PUBLIC_SITE_URL="https://oaxtech.dev"

# --- Email delivery (contact, quote, booking notifications) -------------------
# Resend. EMAIL_API_KEY and EMAIL_TO_ADDRESS must both be set before any form
# can report a delivered message.
#
#   EMAIL_API_KEY      resend.com -> API Keys (starts "re_")
#   EMAIL_TO_ADDRESS   where enquiry notifications land — your own inbox
#   EMAIL_FROM_ADDRESS must be on a domain VERIFIED in Resend, e.g.
#                      "OAX Tech <hello@oaxtech.dev>". Left empty it falls back
#                      to Resend's shared onboarding@resend.dev sender, which
#                      works with no domain setup but can ONLY deliver to the
#                      Resend account owner's own address. Fine for a first
#                      smoke test, not fine for production.
EMAIL_API_KEY=""
EMAIL_TO_ADDRESS=""
EMAIL_FROM_ADDRESS=""

# --- Calendar scheduling (booking) -------------------------------------------
# Cal.com. BOTH values are required — a key with no event type id cannot tell
# which consultation is being booked, and the site treats that as unconfigured.
#
# Until both are set, /api/availability serves the sample grid and the booking
# step states plainly that these are sample times and no slot was reserved.
#
#   CALENDAR_API_KEY        Settings -> Developer -> API keys (starts "cal_")
#   CALENDAR_EVENT_TYPE_ID  Numeric id of the 30-minute consultation event type.
#                           Open the event type; it is the number in the URL.
CALENDAR_API_KEY=""
CALENDAR_EVENT_TYPE_ID=""

# --- File storage (quote attachments) ----------------------------------------
# Uploads must go to a PRIVATE bucket. Never expose uploaded files publicly.
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION=""

# --- Database / persistence --------------------------------------------------
# Postgres. Until this is set the site runs on demo fixtures, and submissions
# captured locally go to a gitignored development file store (.data/) that is
# never used in production.
#
#   npm run db:generate   create a migration from src/lib/db/schema.ts
#   npm run db:migrate    apply migrations
#   npm run db:seed       load demo data (development only)
#   npm run db:studio     browse the data
#
# Local example: postgresql://USER@localhost:5432/oax_tech_dev
DATABASE_URL=""

# --- Authentication (Auth.js) ------------------------------------------------
# Setting AUTH_SECRET turns OFF demo mode for BOTH the client portal and the
# admin, and switches them to real email + password sign-in (argon2id, rate
# limited). Generate one with:  openssl rand -base64 32
#
# Access is then decided by the database, not by this variable:
#   staff  = users.admin_role is set
#   client = a row in client_users for that user
#
#   npm run db:seed-users   create development accounts (never in production)
AUTH_SECRET=""

# --- Payments (portal invoices) ----------------------------------------------
PAYMENTS_SECRET_KEY=""

# --- Spam protection (Turnstile / hCaptcha / reCAPTCHA) ----------------------
SPAM_PROTECTION_SECRET=""
NEXT_PUBLIC_SPAM_PROTECTION_SITE_KEY=""

# --- Analytics ---------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_ID=""
